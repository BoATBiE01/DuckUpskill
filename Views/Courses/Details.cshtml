@model DuckUpskill.ViewModels.CourseDetailsViewModel
@{
    var course = Model.Course;
    ViewData["Title"] = course.Title;
}

<div class="py-5" style="background: linear-gradient(135deg, #FFFDF7 0%, #FFF3E0 100%); border-bottom: 1px solid #FFE0B2;">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2 small">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">คอร์สเรียนทั้งหมด</a></li>
                        <li class="breadcrumb-item active text-warning-emphasis fw-semibold">@course.Category</li>
                    </ol>
                </nav>
                <h1 class="fw-bold mb-3">@course.Title</h1>
                <p class="lead text-muted mb-4">@course.ShortDescription</p>

                <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                    <div class="d-flex align-items-center gap-2">
                        <img src="@(string.IsNullOrEmpty(course.InstructorAvatarUrl) ? "https://placehold.co/80x80" : course.InstructorAvatarUrl)"
                             class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" alt="@course.InstructorName" />
                        <span class="text-dark fw-semibold">@course.InstructorName</span>
                        <span>(@course.InstructorTitle)</span>
                    </div>
                    <span>•</span>
                    <span>⭐ @course.Rating.ToString("F1") (@course.ReviewCount รีวิว)</span>
                    <span>•</span>
                    <span>⏱️ @course.DurationHours ชั่วโมง</span>
                    <span>•</span>
                    <span>📊 @course.Level</span>
                    <span>•</span>
                    <span>👥 @Model.EnrolledCount คนลงทะเบียน</span>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "https://placehold.co/600x350" : course.ThumbnailUrl)"
                         class="card-img-top" style="height: 200px; object-fit: cover;" alt="@course.Title" />
                    <div class="card-body p-4">
                        <div class="mb-3">
                            @if (course.IsFree)
                            {
                                <div class="d-flex align-items-baseline gap-2">
                                    <span class="fs-2 fw-bold text-success">ฟรี (Free)</span>
                                    <span class="text-muted text-decoration-line-through">฿@course.OriginalPrice?.ToString("N0")</span>
                                </div>
                                <span class="badge bg-success-subtle text-success">ไม่มีค่าใช้จ่าย</span>
                            }
                            else
                            {
                                <div class="d-flex align-items-baseline gap-2">
                                    <span class="fs-2 fw-bold text-dark">฿@course.Price.ToString("N0")</span>
                                    @if (course.OriginalPrice.HasValue)
                                    {
                                        <span class="text-muted text-decoration-line-through">฿@course.OriginalPrice.Value.ToString("N0")</span>
                                    }
                                </div>
                                <span class="badge bg-warning-subtle text-warning-emphasis">ชำระครั้งเดียว เข้าเรียนได้ตลอดชีพ</span>
                            }
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            @if (Model.IsEnrolled)
                            {
                                <a asp-action="Learn" asp-route-id="@course.Slug" class="btn btn-lg btn-success fw-bold">
                                    ▶️ เข้าสู่ห้องเรียน (กำลังเรียนอยู่)
                                </a>
                                @if (Model.ProgressPercent > 0)
                                {
                                    <div class="small text-muted text-center">
                                        เรียนไปแล้ว @Model.ProgressPercent% (@Model.CompletedCount/@course.Lessons.Count บท)
                                    </div>
                                }
                            }
                            else if (course.IsFree)
                            {
                                @if (Model.IsAuthenticated)
                                {
                                    <form asp-action="Enroll" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <button type="submit" class="btn btn-lg btn-duck-primary fw-bold w-100">
                                            🎁 สมัครเรียนฟรีทันที
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", new { id = course.Slug })" class="btn btn-lg btn-duck-primary fw-bold">
                                        🔑 เข้าสู่ระบบเพื่อเริ่มเรียนฟรี
                                    </a>
                                }
                            }
                            else
                            {
                                @if (Model.IsAuthenticated)
                                {
                                    <a asp-controller="Orders" asp-action="Checkout" asp-route-courseId="@course.Id" class="btn btn-lg btn-duck-primary fw-bold">
                                        🛒 สั่งซื้อคอร์สนี้ (฿@course.Price.ToString("N0"))
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Checkout", "Orders", new { courseId = course.Id })" class="btn btn-lg btn-duck-primary fw-bold">
                                        🛒 เข้าสู่ระบบเพื่อสั่งซื้อ (฿@course.Price.ToString("N0"))
                                    </a>
                                }
                            }
                        </div>

                        <ul class="list-unstyled small text-muted mb-0">
                            <li class="py-1">✓ เนื้อหาทั้งหมด @course.Lessons.Count บทเรียน</li>
                            <li class="py-1">✓ เข้าถึงได้ตลอดชีพ ไม่จำกัดเวลา</li>
                            <li class="py-1">✓ มีระบบติดตามความคืบหน้าการเรียน</li>
                            <li class="py-1">✓ เรียนบนมือถือและคอมพิวเตอร์ได้ทุกที่</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <!-- Course Description -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h3 class="fw-bold mb-3">รายละเอียดคอร์สเรียน</h3>
                <div style="line-height: 1.8; white-space: pre-line;">
                    @course.Description
                </div>
            </div>

            <!-- Syllabus / Lessons -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold mb-0">สารบัญบทเรียน</h3>
                    <span class="text-muted small">@course.Lessons.Count บทเรียน</span>
                </div>

                <div class="accordion" id="syllabusAccordion">
                    @foreach (var lesson in course.Lessons)
                    {
                        <div class="accordion-item border mb-2 rounded-3 overflow-hidden">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#lesson-@lesson.Id">
                                    <span class="badge bg-light text-dark border me-3">บทที่ @lesson.OrderNumber</span>
                                    <span>@lesson.Title</span>
                                    <span class="ms-auto me-3 small text-muted">@lesson.DurationMinutes นาที</span>
                                    @if (lesson.IsPreview)
                                    {
                                        <span class="badge bg-success me-2">ทดลองฟรี</span>
                                    }
                                </button>
                            </h2>
                            <div id="lesson-@lesson.Id" class="accordion-collapse collapse" data-bs-parent="#syllabusAccordion">
                                <div class="accordion-body text-muted small">
                                    <p>@lesson.Content</p>
                                    @if (Model.IsEnrolled || lesson.IsPreview)
                                    {
                                        <a asp-action="Learn" asp-route-id="@course.Slug" asp-route-lessonId="@lesson.Id" class="btn btn-sm btn-outline-warning text-dark fw-bold">
                                            ▶️ เริ่มเรียนบทนี้
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Instructor Info -->
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <img src="@(string.IsNullOrEmpty(course.InstructorAvatarUrl) ? "https://placehold.co/100x100" : course.InstructorAvatarUrl)"
                     class="rounded-circle mx-auto mb-3" style="width: 80px; height: 80px; object-fit: cover;" alt="@course.InstructorName" />
                <h5 class="fw-bold mb-1">@course.InstructorName</h5>
                <p class="text-muted small mb-3">@course.InstructorTitle</p>
                <div class="p-3 bg-light rounded-3 text-start small text-muted">
                    "พร้อมแบ่งปันความรู้และประสบการณ์ตรง เพื่อช่วยให้ทุกคนอัปสกิลได้อย่างมั่นใจ สนุก และต่อยอดในงานจริงได้ทันที 🦆"
                </div>
            </div>
        </div>
    </div>
</div>
