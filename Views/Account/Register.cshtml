@model DuckUpskill.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "สมัครสมาชิกใหม่";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <div style="font-size: 3.5rem;">🦆✨</div>
                    <h3 class="fw-bold mb-1">สมัครสมาชิก DuckUpskill</h3>
                    <p class="text-muted small">เริ่มต้นเส้นทางการเรียนรู้และอัปสกิลไปกับเรา ฟรี!</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control form-control-lg fs-6" placeholder="ชื่อของคุณ" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control form-control-lg fs-6" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control form-control-lg fs-6" placeholder="อย่างน้อย 8 ตัวอักษร" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg fs-6" placeholder="กรอกรหัสผ่านเดิมอีกครั้ง" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-lg btn-duck-primary fw-bold">
                            🚀 สร้างบัญชีสมาชิก
                        </button>
                    </div>

                    <div class="text-center mt-4 small">
                        มีบัญชีอยู่แล้ว? <a asp-action="Login" class="text-warning-emphasis fw-bold text-decoration-none">เข้าสู่ระบบ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
