@model DuckUpskill.ViewModels.MemberProfileViewModel
@{
    ViewData["Title"] = "โปรไฟล์ของฉัน";
}

<section class="profile-hero py-4">
    <div class="container">
        <div class="d-flex align-items-center gap-3">
            @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="รูปโปรไฟล์ @Model.FullName" class="profile-avatar" />
            }
            else
            {
                <div class="profile-avatar profile-avatar-placeholder">@(Model.FullName.FirstOrDefault())</div>
            }
            <div>
                <span class="badge bg-warning text-dark mb-1">MEMBER</span>
                <h1 class="h3 fw-bold mb-0">@Model.FullName</h1>
                <div class="text-muted">สมาชิกตั้งแต่ @Model.RegisteredAt.ToLocalTime().ToString("dd MMMM yyyy")</div>
            </div>
        </div>
    </div>
</section>

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="row g-3">
                <div class="col-6 col-lg-12">
                    <div class="profile-stat-card">
                        <div class="profile-stat-icon">🎓</div>
                        <div><div class="profile-stat-value">@Model.EnrolledCourseCount</div><div class="text-muted small">คอร์สที่ลงทะเบียน</div></div>
                    </div>
                </div>
                <div class="col-6 col-lg-12">
                    <div class="profile-stat-card">
                        <div class="profile-stat-icon">🏅</div>
                        <div><div class="profile-stat-value">@Model.CompletedCourseCount</div><div class="text-muted small">คอร์สที่เรียนจบ</div></div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mt-3">
                <div class="card-body p-3">
                    <h2 class="h6 fw-bold">เมนูลัด</h2>
                    <a asp-controller="Learning" asp-action="MyCourses" class="profile-shortcut">📚 การเรียนของฉัน <span>→</span></a>
                    <a asp-controller="Orders" asp-action="History" class="profile-shortcut">🧾 ประวัติการสั่งซื้อ <span>→</span></a>
                    <a asp-action="ChangePassword" class="profile-shortcut">🔐 เปลี่ยนรหัสผ่าน <span>→</span></a>
                    <a asp-action="DeleteAccount" class="profile-shortcut text-danger">🗑️ ลบบัญชีของฉัน <span>→</span></a>

                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h2 class="h4 fw-bold mb-1">ข้อมูลส่วนตัว</h2>
                            <p class="text-muted mb-0">แก้ไขชื่อ เบอร์โทรศัพท์ และรูปโปรไฟล์ของคุณ</p>
                        </div>
                        <span class="profile-edit-icon">✏️</span>
                    </div>

                    <form asp-action="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                        }

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control form-control-lg" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control form-control-lg bg-light" readonly />
                            <div class="form-text">อีเมลใช้เข้าสู่ระบบ การเปลี่ยนอีเมลยังไม่เปิดให้แก้จากหน้านี้</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="เช่น 0812345678" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ProfilePicture" class="form-label fw-semibold"></label>
                            <input asp-for="ProfilePicture" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                            <div class="form-text">รองรับ JPG, PNG, WebP ขนาดไม่เกิน 5 MB</div>
                        </div>

                        <input type="hidden" asp-for="RegisteredAt" />
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-duck-primary fw-bold px-4">💾 บันทึกโปรไฟล์</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
