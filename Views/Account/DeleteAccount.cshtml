@model DuckUpskill.ViewModels.DeleteAccountViewModel
@{
    ViewData["Title"] = "ลบบัญชีสมาชิก";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <a asp-action="Profile" class="text-decoration-none text-muted">← กลับไปโปรไฟล์</a>
            <div class="card border-0 shadow-sm rounded-4 mt-3">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="text-danger" style="font-size: 3.5rem;">⚠️</div>
                        <h1 class="h3 fw-bold text-danger">ลบบัญชีสมาชิก</h1>
                        <p class="text-muted mb-0">การดำเนินการนี้ไม่สามารถย้อนกลับได้</p>
                    </div>

                    <div class="alert alert-danger small">
                        บัญชี การลงทะเบียนเรียน ประวัติความคืบหน้า และข้อมูลที่เกี่ยวข้องจะถูกลบอย่างถาวร กรุณาตรวจสอบให้แน่ใจก่อนยืนยัน
                    </div>

                    <form asp-action="DeleteAccount" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                                <button class="btn toggle-password-btn" type="button" tabindex="-1" title="แสดง/ซ่อนรหัสผ่าน" aria-label="แสดง/ซ่อนรหัสผ่าน">
                                    <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                    </svg>
                                    <svg class="eye-closed d-none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
                                        <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/>
                                        <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Confirmation" class="form-label fw-semibold"></label>
                            <input asp-for="Confirmation" class="form-control" placeholder="DELETE" autocomplete="off" />
                            <span asp-validation-for="Confirmation" class="text-danger small"></span>
                            <div class="form-text">พิมพ์คำว่า <strong>DELETE</strong> เป็นตัวพิมพ์ใหญ่เพื่อยืนยัน</div>
                        </div>

                        <div class="d-flex justify-content-between gap-2">
                            <a asp-action="Profile" class="btn btn-outline-secondary">ยกเลิก</a>
                            <button type="submit" class="btn btn-danger fw-bold">ยืนยันลบบัญชี</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
