@model DuckUpskill.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "เปลี่ยนรหัสผ่าน";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <a asp-action="Profile" class="text-decoration-none text-muted">← กลับไปโปรไฟล์</a>
            <div class="card border-0 shadow-sm rounded-4 mt-3">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div style="font-size: 3rem;">🔐</div>
                        <h1 class="h3 fw-bold">เปลี่ยนรหัสผ่าน</h1>
                        <p class="text-muted mb-0">กรอกรหัสผ่านปัจจุบันและตั้งรหัสผ่านใหม่</p>
                    </div>

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Profile" class="btn btn-outline-secondary">ยกเลิก</a>
                            <button type="submit" class="btn btn-duck-primary fw-bold">บันทึกรหัสผ่านใหม่</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
