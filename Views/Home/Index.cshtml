@model IEnumerable<DuckUpskill.Models.Course>
@{
    ViewData["Title"] = "หน้าหลัก - เรียนรู้อัปสกิลแบบเป็ดบินได้";
}

<!-- Hero Section (Modern Luxury Edition) -->
<section class="hero-section">
    <!-- Ambient Glow Orbs in Background -->
    <div class="hero-glow hero-glow-1"></div>
    <div class="hero-glow hero-glow-2"></div>
    <div class="hero-glow hero-glow-3"></div>

    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <!-- Left Content Column -->
            <div class="col-lg-7">
                <div class="hero-badge mb-3">
                    <span class="hero-badge-pulse"></span>
                    <span class="hero-badge-text">แพลตฟอร์มอัปสกิลมาตรฐานสากล 2026</span>
                    <span class="ms-1">✨</span>
                </div>

                <h1 class="hero-title mb-4">
                    เรียนรู้แบบเป็ด <span class="highlight">รู้รอบ เก่งจริง</span><br />
                    พร้อมบินสู่เป้าหมาย 🚀
                </h1>

                <p class="hero-lead mb-4">
                    DuckUpskill แหล่งรวมคอร์สคุณภาพสูงสาย Full-Stack, AI, Data และทักษะทำงานจริง
                    เรียนรู้ด้วยคลิปวิดีโอเจาะลึก ระบบทดสอบวัดผลมาตรฐาน และรับใบประกาศนียบัตรเมื่อเรียนจบ
                </p>

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-lg btn-duck-luxury">
                        <span>สำรวจคอร์สเรียนทั้งหมด</span>
                        <svg class="btn-arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                    <a asp-controller="Courses" asp-action="Index" asp-route-priceType="free" class="btn btn-lg btn-duck-glass">
                        <span>🎁 เริ่มเรียนคอร์สฟรี 100%</span>
                    </a>
                </div>

                <!-- Social Proof & Trust Bar -->
                <div class="hero-trust-bar pt-3 d-flex align-items-center gap-3 flex-wrap">
                    <div class="avatar-group">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80" alt="student" class="avatar-sm" />
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=80&q=80" alt="student" class="avatar-sm" />
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=80&q=80" alt="student" class="avatar-sm" />
                        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=80&q=80" alt="student" class="avatar-sm" />
                        <span class="avatar-count">+2.5k</span>
                    </div>
                    <div class="trust-rating">
                        <div class="stars">⭐⭐⭐⭐⭐ <strong class="text-dark ms-1">4.9 / 5.0</strong></div>
                        <div class="small text-muted">จากผู้เรียนจริงกว่า 2,500+ คนทั่วประเทศ</div>
                    </div>
                </div>

                <!-- Perks checklist -->
                <div class="d-flex align-items-center gap-4 text-muted small mt-4 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <span class="perk-check">✓</span> เข้าเรียนได้ตลอดชีพ 24 ชม.
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="perk-check">✓</span> มี Certificate รับรองหลังจบ
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="perk-check">✓</span> อัปเดตเนื้อหาใหม่ 2026
                    </div>
                </div>
            </div>

            <!-- Right Showcase Visual -->
            <div class="col-lg-5">
                <div class="hero-showcase-wrapper">
                    <!-- Main Showcase Card -->
                    <div class="hero-main-card">
                        <div class="hero-card-media position-relative">
                            <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=800&q=80" alt="Featured Course" class="hero-card-img" />
                            <div class="hero-card-overlay"></div>
                            <span class="hero-card-tag">🏆 คอร์สแนะนำยอดนิยม</span>
                            <div class="hero-play-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393"/>
                                </svg>
                            </div>
                        </div>
                        <div class="hero-card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-warning-subtle text-warning-emphasis fw-bold">Full-Stack Development</span>
                                <span class="text-muted small">⏱️ 18 ชั่วโมง</span>
                            </div>
                            <h5 class="fw-bold mb-3 text-dark">Full-Stack ASP.NET Core & Modern UI</h5>
                            <div class="hero-card-progress mb-2">
                                <div class="d-flex justify-content-between text-muted small mb-1">
                                    <span>ความคืบหน้าการเรียน</span>
                                    <span class="fw-bold text-dark">บทที่ 3 จาก 5 · 60%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-warning" style="width: 60%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Glass Badge 1: Certificate -->
                    <div class="hero-float-badge badge-top-right">
                        <div class="float-badge-icon badge-icon-gold">🏅</div>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.92rem;">Certificate รับรอง</div>
                            <small class="text-muted">วุฒิบัตรจบหลักสูตรทันที</small>
                        </div>
                    </div>

                    <!-- Floating Glass Badge 2: Pre & Post Test -->
                    <div class="hero-float-badge badge-bottom-left">
                        <div class="float-badge-icon badge-icon-green">🎯</div>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.92rem;">Pre & Post-Test</div>
                            <small class="text-muted">วัดผลตรงตามเกณฑ์จริง</small>
                        </div>
                    </div>

                    <!-- Floating Mascot Stamp -->
                    <div class="hero-mascot-stamp">
                        <div class="stamp-inner">
                            <span class="stamp-duck">🦆</span>
                            <span class="stamp-verified">✓</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Counter Bar (Upgraded Modern Glass) -->
<section class="hero-stats-bar py-4">
    <div class="container">
        <div class="row g-4 text-center align-items-center">
            <div class="col-md-4">
                <div class="stat-box">
                    <span class="stat-icon">📚</span>
                    <div>
                        <h3 class="fw-bold text-dark mb-0 brand-font">@(ViewBag.TotalCourses ?? 28)+</h3>
                        <p class="text-muted small mb-0">คอร์สเรียนคุณภาพพร้อมคลิปเจาะลึก</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 border-start-md">
                <div class="stat-box">
                    <span class="stat-icon">👥</span>
                    <div>
                        <h3 class="fw-bold text-warning-emphasis mb-0 brand-font">@(ViewBag.TotalMembers ?? 100)+</h3>
                        <p class="text-muted small mb-0">ผู้เรียนที่กำลังอัปสกิลกับเรา</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 border-start-md">
                <div class="stat-box">
                    <span class="stat-icon">🏅</span>
                    <div>
                        <h3 class="fw-bold text-success mb-0 brand-font">100%</h3>
                        <p class="text-muted small mb-0">รับรอง Certificate ทันทีที่สอบผ่าน</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Courses Section -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
            <div>
                <span class="badge bg-warning text-dark px-3 py-2 fw-bold mb-2">⭐ คัดสรรพิเศษ</span>
                <h2 class="section-title mb-1">คอร์สเรียนแนะนำยอดนิยม</h2>
                <p class="section-subtitle mb-0">เลือกเรียนได้ทั้งแบบเริ่มต้นฟรี และคอร์สระดับมืออาชีพ</p>
            </div>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-warning text-dark fw-bold">
                ดูคอร์สทั้งหมด →
            </a>
        </div>

        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="course-card">
                        <div class="course-thumb-wrap">
                            <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "https://placehold.co/600x400" : course.ThumbnailUrl)"
                                 class="course-thumb" alt="@course.Title" />
                            @if (course.IsFree)
                            {
                                <span class="badge-price-free">ฟรี (Free)</span>
                            }
                            else
                            {
                                <span class="badge-price-paid">฿@course.Price.ToString("N0")</span>
                            }
                        </div>
                        <div class="course-card-body">
                            <div class="course-category">@course.Category</div>
                            <h4 class="course-title">
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Slug" class="text-decoration-none text-dark">
                                    @course.Title
                                </a>
                            </h4>
                            <p class="course-desc">@course.ShortDescription</p>

                            <div class="d-flex align-items-center gap-2 mb-3 small text-muted">
                                <span>⏱️ @course.DurationHours ชม.</span>
                                <span>•</span>
                                <span>⭐ @course.Rating.ToString("F1") (@course.ReviewCount)</span>
                                <span>•</span>
                                <span>🎓 @course.Level</span>
                            </div>

                            <div class="course-footer">
                                <div>
                                    @if (course.IsFree)
                                    {
                                        <span class="price-display text-success">ฟรี 0 บาท</span>
                                    }
                                    else
                                    {
                                        <span class="price-display">฿@course.Price.ToString("N0")</span>
                                        @if (course.OriginalPrice.HasValue)
                                        {
                                            <span class="original-price">฿@course.OriginalPrice.Value.ToString("N0")</span>
                                        }
                                    }
                                </div>
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Slug" class="btn btn-sm btn-duck-primary fw-semibold">
                                    ดูรายละเอียด
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Banner Call to Action -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container text-center py-4">
        <h2 class="fw-bold mb-3 brand-font">พร้อมจะอัปสกิลตัวเองแล้วหรือยัง? 🦆</h2>
        <p class="lead text-muted mb-4 mx-auto" style="max-width: 650px;">
            สมัครสมาชิกฟรีวันนี้ เข้าถึงคอร์สพื้นฐานได้ทันที หรือเลือกคอร์สพรีเมียมเพื่อต่อยอดการทำงานจริง
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Account" asp-action="Register" class="btn btn-lg btn-duck-primary px-4 fw-bold">
                สมัครสมาชิกฟรีทันที
            </a>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-lg btn-outline-secondary px-4 fw-bold">
                ค้นหาคอร์สเรียน
            </a>
        </div>
    </div>
</section>
