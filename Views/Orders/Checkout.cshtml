@model DuckUpskill.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "ชำระเงิน - " + Model.Course.Title;
}

<div class="py-4 bg-white border-bottom mb-4">
    <div class="container">
        <h1 class="fw-bold mb-0">🛒 สั่งซื้อและชำระเงิน (Mock Checkout)</h1>
        <p class="text-muted mb-0">ขั้นตอนการชำระเงินจำลองเพื่อปลดล็อกคอร์สเรียน</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <!-- Course summary -->
        <div class="col-lg-5 order-lg-2">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
                <h4 class="fw-bold mb-3">สรุปคำสั่งซื้อ</h4>
                <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
                    <img src="@(string.IsNullOrEmpty(Model.Course.ThumbnailUrl) ? "https://placehold.co/100x70" : Model.Course.ThumbnailUrl)"
                         class="rounded" style="width: 90px; height: 60px; object-fit: cover;" alt="thumb" />
                    <div>
                        <h6 class="fw-bold mb-1">@Model.Course.Title</h6>
                        <small class="text-muted">ผู้สอน: @Model.Course.InstructorName</small>
                    </div>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">ราคาคอร์ส</span>
                    <span class="fw-bold">฿@Model.Course.Price.ToString("N0")</span>
                </div>
                @if (Model.Course.OriginalPrice.HasValue)
                {
                    <div class="d-flex justify-content-between mb-2 text-muted small">
                        <span>ส่วนลดพิเศษ</span>
                        <span class="text-success">-฿@((Model.Course.OriginalPrice.Value - Model.Course.Price).ToString("N0"))</span>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between mb-4 fs-5">
                    <strong>ยอดชำระสุทธิ</strong>
                    <strong class="text-warning-emphasis">฿@Model.Course.Price.ToString("N0")</strong>
                </div>

                <div class="alert alert-warning border-0 small mb-0">
                    💡 <strong>หมายเหตุ:</strong> หน้านี้เป็นระบบชำระเงินจำลอง (Mock Payment) สำหรับการทดสอบ เมื่อกดปุ่มชำระเงิน ระบบจะทำการปลดล็อกคอร์สให้ทันทีโดยไม่มีการหักเงินจริง
                </div>
            </div>
        </div>

        <!-- Payment method & mock QR -->
        <div class="col-lg-7 order-lg-1">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h4 class="fw-bold mb-3">วิธีการชำระเงิน</h4>

                <div class="border rounded-4 p-3 mb-4 bg-light">
                    <div class="form-check d-flex align-items-center gap-3">
                        <input class="form-check-input" type="radio" name="payRadio" id="payQr" checked>
                        <label class="form-check-label fw-bold d-flex align-items-center gap-2" for="payQr">
                            <span>📱</span> PromptPay QR Code (สแกนจ่ายเงินจำลอง)
                        </label>
                    </div>

                    <div class="text-center py-4 bg-white rounded-3 mt-3 border">
                        <div class="badge bg-primary px-3 py-1 mb-2">PROMPTPAY THAI QR</div>
                        <div class="my-2">
                            <!-- SVG QR Mock -->
                            <svg width="180" height="180" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                                <rect width="200" height="200" fill="white" />
                                <rect x="20" y="20" width="50" height="50" fill="black" />
                                <rect x="30" y="30" width="30" height="30" fill="white" />
                                <rect x="38" y="38" width="14" height="14" fill="black" />
                                <rect x="130" y="20" width="50" height="50" fill="black" />
                                <rect x="140" y="30" width="30" height="30" fill="white" />
                                <rect x="148" y="38" width="14" height="14" fill="black" />
                                <rect x="20" y="130" width="50" height="50" fill="black" />
                                <rect x="30" y="140" width="30" height="30" fill="white" />
                                <rect x="38" y="148" width="14" height="14" fill="black" />
                                <rect x="90" y="30" width="20" height="20" fill="black" />
                                <rect x="85" y="70" width="30" height="30" fill="#FFB800" rx="4" />
                                <text x="100" y="92" font-size="20" text-anchor="middle">🦆</text>
                                <rect x="130" y="130" width="20" height="20" fill="black" />
                                <rect x="155" y="155" width="25" height="25" fill="black" />
                                <rect x="90" y="120" width="20" height="40" fill="black" />
                            </svg>
                        </div>
                        <div class="fw-bold fs-5 text-dark">ยอดชำระ: ฿@Model.Course.Price.ToString("N0")</div>
                        <div class="small text-muted">ชื่อบัญชีจำลอง: DuckUpskill Thailand</div>
                    </div>
                </div>

                <form asp-action="ProcessCheckout" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@Model.Course.Id" />
                    <input type="hidden" name="paymentMethod" value="PromptPay QR (Mock)" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">ชื่อผู้โอน / หมายเหตุอ้างอิง (ทางเลือก)</label>
                        <input type="text" name="accountName" class="form-control" placeholder="เช่น เป็ดใจดี ขยันเรียน" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">เลขอ้างอิงสลิปจำลอง (ทางเลือก)</label>
                        <input type="text" name="slipNotes" class="form-control" placeholder="MOCK-SLIP-998877" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-lg btn-duck-primary fw-bold py-3">
                            ✅ ยืนยันการชำระเงินจำลอง (฿@Model.Course.Price.ToString("N0"))
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
