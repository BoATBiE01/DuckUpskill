@model DuckUpskill.Models.Order
@{
    ViewData["Title"] = "ชำระเงินสำเร็จ!";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-lg rounded-4 p-5 mx-auto" style="max-width: 600px;">
        <div style="font-size: 5rem;">🎉🦆</div>
        <h2 class="fw-bold text-success mt-3 mb-2">ชำระเงินสำเร็จเรียบร้อยแล้ว!</h2>
        <p class="text-muted mb-4">ขอบคุณที่ร่วมอัปสกิลกับเรา คอร์สนี้ถูกปลดล็อกให้บัญชีของคุณแล้ว</p>

        <div class="bg-light rounded-4 p-3 text-start mb-4 border">
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">เลขที่คำสั่งซื้อ:</span>
                <strong>@Model.OrderNumber</strong>
            </div>
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">คอร์สที่ซื้อ:</span>
                <strong class="text-truncate" style="max-width: 250px;">@Model.Course?.Title</strong>
            </div>
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">ยอดเงิน:</span>
                <strong class="text-warning-emphasis">฿@Model.Amount.ToString("N0")</strong>
            </div>
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">วิธีชำระ:</span>
                <span>@Model.PaymentMethod</span>
            </div>
            <div class="d-flex justify-content-between py-1">
                <span class="text-muted">เวลาชำระเงิน:</span>
                <span>@Model.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>

        <div class="d-grid gap-2">
            @if (Model.Course != null)
            {
                <a asp-controller="Courses" asp-action="Learn" asp-route-id="@Model.Course.Slug" class="btn btn-lg btn-duck-primary fw-bold py-3">
                    ▶️ เข้าห้องเรียนทันที
                </a>
            }
            <a asp-controller="Learning" asp-action="MyCourses" class="btn btn-outline-secondary">
                ดูคอร์สทั้งหมดของฉัน
            </a>
        </div>
    </div>
</div>
