@model DuckUpskill.Models.ApplicationUser
@{
    ViewData["Title"] = "เพิ่มผู้ใช้ใหม่";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small">← กลับไปจัดการสมาชิก</a>
    <h2 class="fw-bold mt-2">➕ เพิ่มผู้ใช้ใหม่</h2>
    <p class="text-muted">สร้างบัญชีสมาชิกหรือบัญชีผู้ดูแลระบบ (Admin)</p>
</div>

<div class="admin-card p-4">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label fw-semibold"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">รหัสผ่านเริ่มต้น</label>
                <input name="password" type="password" class="form-control" required minlength="8" />
                <small class="text-muted">อย่างน้อย 8 ตัวอักษร</small>
            </div>
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label fw-semibold">เบอร์โทรศัพท์</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input type="checkbox" name="makeAdmin" value="true" class="form-check-input" id="makeAdmin" />
                    <label class="form-check-label fw-semibold" for="makeAdmin">กำหนดเป็นผู้ดูแลระบบ (Admin)</label>
                    <div class="form-text text-danger">สิทธิ์ Admin สามารถจัดการทุกข้อมูลและผู้ใช้งานในระบบได้</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
            <button type="submit" class="btn btn-duck-primary fw-bold px-4">➕ สร้างบัญชีผู้ใช้งาน</button>
        </div>
    </form>
</div>
