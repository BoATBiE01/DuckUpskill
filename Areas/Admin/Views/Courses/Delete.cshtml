@model DuckUpskill.Models.Course
@{
    ViewData["Title"] = "ยืนยันการลบคอร์สเรียน";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small">← กลับไปจัดการคอร์ส</a>
    <h2 class="fw-bold text-danger mt-2">🗑️ ยืนยันการลบคอร์สเรียน</h2>
    <p class="text-muted">คุณแน่ใจหรือไม่ว่าต้องการลบคอร์สนี้? บทเรียนและสถิติทั้งหมดที่เกี่ยวข้องจะถูกลบไปด้วย</p>
</div>

<div class="admin-card p-4">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <img src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "https://placehold.co/120x80" : Model.ThumbnailUrl)"
             class="rounded" style="width: 100px; height: 65px; object-fit: cover;" alt="thumb" />
        <div>
            <h4 class="fw-bold mb-1">@Model.Title</h4>
            <div class="text-muted small">ผู้สอน: @Model.InstructorName | มี @Model.Lessons.Count บทเรียน | นักเรียน @Model.Enrollments.Count คน</div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
            <button type="submit" class="btn btn-danger fw-bold px-4">ยืนยันการลบคอร์สนี้</button>
        </div>
    </form>
</div>
